<a href="<%= href %>" class="block bg-paper-sheet border border-taupe-200 no-underline text-inherit transition-[border-color,box-shadow] duration-150 hover:border-verdigris-300 hover:shadow-lifted dark:bg-ink-700 dark:border-ink-500 dark:hover:border-verdigris-400">
  <% case preview_style %>
  <% when :waveform %>
    <div class="h-32 bg-dusty-50 border-b border-taupe-200 flex items-center gap-0.5 p-4 dark:bg-ink-600 dark:border-ink-500" aria-hidden="true">
      <% CollectionCardComponent::WAVEFORM_HEIGHTS.each do |height| %>
        <div class="flex-1 <%= height >= 62 ? "bg-dusty-400" : "bg-dusty-300" %>" style="height: <%= height %>%"></div>
      <% end %>
    </div>
  <% when :slate %>
    <div class="h-32 bg-dusty-50 border-b border-taupe-200 flex items-center justify-center p-4 dark:bg-ink-600 dark:border-ink-500" aria-hidden="true">
      <div class="w-42 h-23.5 bg-dusty-100 border border-dusty-300 flex items-center justify-center dark:bg-ink-700 dark:border-ink-400">
        <span class="block w-0 h-0 border-l-[16px] border-l-dusty-500 border-y-[11px] border-y-transparent dark:border-l-dusty-300"></span>
      </div>
    </div>
  <% else %>
    <div class="mat h-32 border-b border-taupe-200 gap-2.5 p-4 dark:border-ink-500">
      <% if preview_artifacts.any? %>
        <% preview_artifacts.first(3).each do |artifact| %>
          <div class="h-full flex-none flex items-center">
            <%= render ArtifactThumbnailComponent.new(artifact: artifact, icon_size: "w-8 h-8") %>
          </div>
        <% end %>
      <% else %>
        <%= helpers.icon_tag type.empty_icon, css: "w-10 h-10 text-taupe-400 dark:text-ink-300" %>
      <% end %>
    </div>
  <% end %>
  <div class="px-5.5 pt-5 pb-5.5">
    <div class="flex items-baseline justify-between gap-3.5 mb-2">
      <h3 class="font-serif text-23 font-medium m-0 text-taupe-900 dark:text-ink-50"><%= type.plural_display_name %></h3>
      <span class="font-mono text-xs text-taupe-600 dark:text-ink-200"><%= count %></span>
    </div>
    <p class="text-15 leading-160 text-taupe-700 m-0 dark:text-ink-100"><%= type.description %></p>
  </div>
</a>
