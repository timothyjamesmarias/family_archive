<%= helpers.turbo_frame_tag "tree_form" do %>
  <div class="tree-form">
    <h2 class="tree-form-heading" id="tree_form_heading"><%= @heading %></h2>
    <% if @error %>
      <%= render Ui::MessageComponent.new(level: :error).with_content(@error) %>
    <% end %>
    <%= content %>
  </div>
<% end %>
