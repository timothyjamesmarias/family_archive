<a href="<%= href %>" class="block bg-paper-sheet border border-taupe-200 no-underline text-inherit transition-[border-color,box-shadow] duration-150 hover:border-verdigris-300 hover:shadow-lifted dark:bg-ink-700 dark:border-ink-500 dark:hover:border-verdigris-400">
  <div class="mat relative h-45 border-b border-taupe-200 p-3.5 dark:border-ink-500">
    <%= render ArtifactThumbnailComponent.new(artifact: artifact) %>
    <% if show_badge? %>
      <span class="absolute right-3.5 top-3.5 font-mono text-10 text-paper-sheet bg-verdigris-700/90 px-1.75 py-0.75"><%= badge_count %></span>
    <% end %>
  </div>
  <div class="px-4 pt-3.5 pb-4">
    <% if title %>
      <div class="font-serif text-17 leading-135 mb-1.5 text-taupe-900 dark:text-ink-50"><%= title %></div>
    <% else %>
      <div class="font-serif text-17 leading-135 mb-1.5 italic text-taupe-600 dark:text-ink-200"><%= untitled_label %></div>
    <% end %>
    <div class="meta"><%= meta_line %></div>
  </div>
</a>
