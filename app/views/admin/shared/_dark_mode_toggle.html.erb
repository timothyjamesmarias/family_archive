<button
  class="p-2 rounded-md bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors border border-slate-200 dark:border-slate-700"
  data-controller="dark-mode"
  data-action="dark-mode#toggle"
  aria-label="Toggle dark mode"
>
  <%= icon_tag "sun", css: "w-5 h-5 text-slate-700 dark:text-slate-300 hidden dark:block" %>
  <%= icon_tag "moon", css: "w-5 h-5 text-slate-700 dark:text-slate-300 block dark:hidden" %>
</button>
