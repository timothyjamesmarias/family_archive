<% content_for :title, "Artifacts" %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900">Artifacts</h1>
  <%= link_to "Upload artifact", new_admin_artifact_path, class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
</div>

<%= form_with url: admin_artifacts_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search…", class: "w-64 rounded border border-slate-300 px-3 py-2 text-sm" %>
  <%= select_tag :artifact_type,
        options_for_select(ArtifactType::ALL.map { |t| [ t.display_name, t.key ] }, params[:artifact_type]),
        include_blank: "All types", class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
  <%= submit_tag "Filter", class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100 cursor-pointer" %>
<% end %>

<div class="overflow-x-auto rounded border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Title</th>
        <th class="px-4 py-3">Type</th>
        <th class="px-4 py-3">Slug</th>
        <th class="px-4 py-3">Files</th>
        <th class="px-4 py-3">Uploaded</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @artifacts.records.each do |artifact| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3"><%= artifact.title || "Untitled" %></td>
          <td class="px-4 py-3"><%= artifact.type.display_name %></td>
          <td class="px-4 py-3"><%= artifact.slug %></td>
          <td class="px-4 py-3"><%= artifact.files.size %></td>
          <td class="px-4 py-3"><%= artifact.uploaded_at.strftime("%Y-%m-%d") %></td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <%= link_to "View", admin_artifact_path(artifact), class: "text-slate-600 underline" %>
            <%= link_to "Edit", edit_admin_artifact_path(artifact), class: "ml-2 text-slate-600 underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "admin/shared/pagination", page: @artifacts, base_url: admin_artifacts_path %>
