<% title = "Annotations — #{@artifact.title || @artifact.slug}" %>
<% content_for :title, title %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= title %></h1>
  <%= link_to "Back to artifact", admin_artifact_path(@artifact),
        class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
</div>

<% if @file %>
  <% annotations = @file.annotations.sort_by(&:id) %>
  <% if @files.size > 1 %>
    <nav class="flex gap-1 mb-4 border-b border-slate-200 dark:border-slate-800 text-sm">
      <% @files.each do |file| %>
        <%= link_to "File #{file.file_sequence} (#{file.annotations.size})",
              annotations_admin_artifact_path(@artifact, file: file.id),
              aria: { current: ("page" if file == @file) },
              class: "-mb-px border-b-2 px-3 py-2 #{file == @file ? "border-slate-900 dark:border-slate-100 font-medium" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-slate-100"}" %>
      <% end %>
    </nav>
  <% end %>

  <div class="mb-4">
    <%= button_to "Add annotation", new_admin_artifact_file_annotation_path(@file), method: :get,
          params: { x: 0.5, y: 0.5 }, form: { data: { turbo_frame: "annotation_form" } },
          class: "rounded bg-slate-900 dark:bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:hover:bg-slate-600 cursor-pointer" %>
  </div>

  <div class="flex flex-col md:flex-row gap-4 items-start"
       data-controller="photo-annotations annotation-editor"
       data-annotation-editor-new-url-value="<%= new_admin_artifact_file_annotation_path(@file) %>"
       data-action="click@window->annotation-editor#dismiss keydown.esc@window->annotation-editor#close turbo:submit-end->annotation-editor#refresh">
    <div class="relative flex-1 min-w-0 rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4"
         data-annotation-editor-target="stage">
      <%= render "admin/annotations/stage", file: @file, annotations: annotations %>
      <%= turbo_frame_tag "annotation_form", class: "absolute z-10", data: { annotation_editor_target: "frame" } %>
    </div>
    <div class="w-full md:w-80 shrink-0 rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
      <%= render "admin/annotations/list", annotations: annotations %>
    </div>
  </div>
<% else %>
  <p class="text-sm text-slate-500 dark:text-slate-400">This artifact has no files to annotate.</p>
<% end %>
