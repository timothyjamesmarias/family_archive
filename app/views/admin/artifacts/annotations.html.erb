<% title = "Annotations — #{@artifact.title || @artifact.slug}" %>
<% content_for :title, title %>
<%# Saves redirect back here; morphing keeps the scroll position and the
    selected file instead of repainting the page. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= title %></h1>
  <%= render Admin::ButtonComponent.new(variant: :secondary, href: admin_artifact_path(@artifact)).with_content("Back to artifact") %>
</div>

<% if @file %>
  <% if @files.size > 1 %>
    <%= render Admin::TabsComponent.new(current: annotations_admin_artifact_path(@artifact, file: @file.id)) do |tabs| %>
      <% @files.each do |file| %>
        <% tabs.with_tab(label: "File #{file.file_sequence} (#{file.annotations.size})",
                         href: annotations_admin_artifact_path(@artifact, file: file.id)) %>
      <% end %>
    <% end %>
  <% end %>
  <%= render Admin::Annotations::EditorComponent.new(file: @file) %>
<% else %>
  <p class="text-sm text-slate-500 dark:text-slate-400">This artifact has no files to annotate.</p>
<% end %>
