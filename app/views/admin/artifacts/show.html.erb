<% title = @artifact.title || "Untitled #{@artifact.type.display_name}" %>
<% content_for :title, title %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100"><%= title %></h1>
  <div class="flex gap-2">
    <%= link_to "View on site", "/#{@artifact.type.route_segment}/#{@artifact.slug}",
          class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
    <% if @artifact.type.key == "PHOTO" %>
      <%= link_to "Edit annotations", annotations_admin_artifact_path(@artifact),
            class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
    <% end %>
    <%= link_to "Edit", edit_admin_artifact_path(@artifact), class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
    <%= button_to "Delete", admin_artifact_path(@artifact), method: :delete,
          data: { turbo_confirm: "Delete this artifact and all of its files?" },
          class: "rounded border border-red-300 dark:border-red-800 px-4 py-2 text-sm text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950 cursor-pointer" %>
  </div>
</div>

<dl class="rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-100 dark:divide-slate-800 text-sm">
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Type</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @artifact.type.display_name %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Slug</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @artifact.slug %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Original date</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @artifact.original_date_string %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Uploaded</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @artifact.uploaded_at.strftime("%Y-%m-%d %H:%M") %></dd>
  </div>
</dl>

<h2 class="mt-8 mb-3 text-lg font-semibold text-slate-900 dark:text-slate-100">Files</h2>
<div data-testid="artifact-files" class="rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-100 dark:divide-slate-800">
  <% @artifact.files.each do |file| %>
    <div class="flex items-center gap-4 px-4 py-3 text-sm">
      <div class="w-20 h-20 shrink-0 bg-slate-100 dark:bg-slate-800 rounded overflow-hidden flex items-center justify-center">
        <% if file.thumbnail? %>
          <%= image_tag url_for(file.file.variant(:thumb)), alt: "", class: "w-full h-full object-cover" %>
        <% elsif file.image? %>
          <%= image_tag url_for(file.file), alt: "", class: "w-full h-full object-cover" %>
        <% elsif file.file.attached? %>
          <span class="text-xs text-slate-400 dark:text-slate-500"><%= file.file.blob.content_type.to_s.split("/").last %></span>
        <% end %>
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-slate-900 dark:text-slate-100 truncate">#<%= file.file_sequence %> · <%= file.file.attached? ? file.file.blob.filename : "(no file)" %></p>
        <% if file.file.attached? %>
          <p class="text-slate-500 dark:text-slate-400">
            <%= file.file.blob.content_type %> · <%= number_to_human_size(file.file.blob.byte_size) %>
            <% if file.annotations.any? %> · <%= pluralize(file.annotations.size, "annotation") %><% end %>
          </p>
        <% end %>
      </div>
      <% if @artifact.files.size > 1 %>
        <%# A native post and full page load, as before the Stimulus port. Turbo
            would keep the flash too now that no reload meta is involved, but
            switching is untested. %>
        <%= button_to "Delete", file_admin_artifact_path(@artifact, file.id), method: :delete,
              form: { data: { turbo: false }, onsubmit: "return confirm('Delete this file?')" },
              class: "text-red-700 dark:text-red-400 underline cursor-pointer" %>
      <% else %>
        <span class="text-xs text-slate-400 dark:text-slate-500">The only file can't be deleted</span>
      <% end %>
    </div>
  <% end %>
</div>

<h3 class="mt-6 mb-2 text-sm font-semibold text-slate-700 dark:text-slate-300">Add files</h3>
<%# Uppy picks the files; the form still posts natively (data: { turbo: false })
    and redirects with a full page load, as before the Stimulus port. A Turbo
    submit should work now that no reload meta is involved, but is untested. %>
<%= form_with url: add_files_admin_artifact_path(@artifact), method: :post, multipart: true,
      data: { turbo: false, controller: "uppy-picker",
              uppy_picker_note_value: "Up to 10 files, 150MB each. They continue the sequence.",
              uppy_picker_empty_message_value: "Choose at least one file to add",
              uppy_picker_height_value: 250 },
      class: "max-w-xl space-y-3" do %>
  <%= file_field_tag "files[]", multiple: true, class: "hidden", data: { uppy_picker_target: "input" } %>
  <div data-uppy-picker-target="dashboard"></div>
  <button type="button" data-uppy-picker-target="submit" data-action="uppy-picker#submit"
          class="rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800 cursor-pointer disabled:opacity-50">
    Add files
  </button>
<% end %>

<div class="mt-6">
  <%= link_to "← Back to artifacts", admin_artifacts_path, class: "text-slate-600 dark:text-slate-400 underline" %>
</div>
