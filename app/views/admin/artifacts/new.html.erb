<% content_for :title, "Upload artifact" %>
<h1 class="text-2xl font-semibold text-slate-900 mb-6">Upload artifact</h1>

<%= form_with url: admin_artifacts_path, method: :post, multipart: true, class: "max-w-xl space-y-4" do |form| %>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Files</label>
    <span class="text-xs text-slate-500">The first file becomes the primary file. Max 50&nbsp;MB each.</span>
    <%= file_field_tag "files[]", multiple: true, required: true, class: "w-full text-sm" %>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Type</label>
    <%= select_tag "artifact[artifact_type]",
          options_for_select(ArtifactType::ALL.map { |t| [ t.display_name, t.key ] }, params.dig(:artifact, :artifact_type)),
          include_blank: "Choose a type…", required: true,
          class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Title</label>
    <%= text_field_tag "artifact[title]", params.dig(:artifact, :title), class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
  </div>
  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Original date</label>
    <span class="text-xs text-slate-500">Free text, e.g. "Summer 1943"</span>
    <%= text_field_tag "artifact[original_date_string]", params.dig(:artifact, :original_date_string), class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
  </div>

  <div class="flex gap-2 pt-2">
    <%= submit_tag "Upload", class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_artifacts_path, class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
  </div>
<% end %>
