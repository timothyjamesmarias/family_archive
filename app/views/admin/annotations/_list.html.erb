<%# locals: (annotations:) %>
<h2 class="mb-2 text-sm font-semibold text-slate-900 dark:text-slate-100">Annotations (<%= annotations.size %>)</h2>
<% if annotations.empty? %>
  <p class="text-sm text-slate-500 dark:text-slate-400">No annotations on this file.</p>
<% end %>
<div class="flex flex-col gap-1">
  <% annotations.each_with_index do |annotation, index| %>
    <button type="button"
            class="flex gap-2 items-start rounded p-1 text-left cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 [&.annotation-row-selected]:bg-slate-200 dark:[&.annotation-row-selected]:bg-slate-700"
            data-photo-annotations-target="row"
            data-annotation-id="<%= annotation.id %>"
            data-action="photo-annotations#select">
      <span class="flex items-center justify-center size-5.5 shrink-0 rounded-full bg-slate-900 text-xs text-white" aria-hidden="true"><%= index + 1 %></span>
      <span class="text-sm text-slate-900 dark:text-slate-100"><%= annotation.annotation_text %></span>
    </button>
  <% end %>
</div>
