<%# locals: (file:, annotation:) %>
<div class="w-80 space-y-3 rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4 shadow-lg">
  <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100"><%= annotation.persisted? ? "Edit annotation" : "Add annotation" %></h2>
  <%= form_with model: [ :admin, file, annotation ], class: "space-y-3" do |form| %>
    <%= render "admin/shared/form_errors", record: annotation %>
    <div>
      <%= form.label :annotation_text, class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
      <%= form.text_field :annotation_text, autofocus: true, placeholder: "Enter description…",
            class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
    </div>
    <%= form.hidden_field :x_coord %>
    <%= form.hidden_field :y_coord %>
    <div class="flex gap-2 justify-end">
      <%= link_to "Cancel", annotations_admin_artifact_path(file.artifact_id, file: file.id),
            class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
      <%= form.submit "Save", class: "rounded bg-slate-900 dark:bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:hover:bg-slate-600 cursor-pointer" %>
    </div>
  <% end %>
  <% if annotation.persisted? %>
    <%# Outside the form above: forms cannot nest. %>
    <%= button_to "Delete", admin_artifact_file_annotation_path(file, annotation), method: :delete,
          data: { turbo_confirm: "Delete this annotation?" },
          class: "text-sm text-red-700 dark:text-red-400 underline cursor-pointer" %>
  <% end %>
</div>
