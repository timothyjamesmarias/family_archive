<% content_for :title, "Thumbnails" %>
<h1 class="text-2xl font-semibold text-slate-900 mb-6">Thumbnails</h1>

<dl class="grid grid-cols-1 gap-4 sm:grid-cols-3 mb-8">
  <% {
    "Total artifacts" => @stats[:total_artifacts],
    "Image artifacts" => @stats[:total_image_artifacts],
    "With thumbnails" => @stats[:with_thumbnails],
    "Without thumbnails" => @stats[:without_thumbnails],
    "Too large to process" => @stats[:too_large_to_process]
  }.each do |label, count| %>
    <div class="rounded border border-slate-200 bg-white p-4">
      <dt class="text-sm text-slate-600"><%= label %></dt>
      <dd class="mt-1 text-2xl font-semibold text-slate-900"><%= count %></dd>
    </div>
  <% end %>
</dl>

<div class="space-y-6 max-w-xl">
  <div class="rounded border border-slate-200 bg-white p-5">
    <h2 class="font-semibold text-slate-900 mb-1">Backfill missing thumbnails</h2>
    <p class="text-sm text-slate-600 mb-3">Generates thumbnails only for image artifacts that have none.</p>
    <%= form_with url: backfill_admin_thumbnails_path, method: :post, class: "flex items-center gap-2" do %>
      <%= select_tag :size, options_for_select(ThumbnailGenerator::SIZES.map { |s| [ "#{s}px", s ] }, ThumbnailGenerator::MEDIUM), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      <%= submit_tag "Backfill", class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 cursor-pointer" %>
    <% end %>
  </div>

  <div class="rounded border border-slate-200 bg-white p-5">
    <h2 class="font-semibold text-slate-900 mb-1">Regenerate all thumbnails</h2>
    <p class="text-sm text-slate-600 mb-3">Regenerates every image artifact's thumbnail, replacing existing ones.</p>
    <%= form_with url: regenerate_admin_thumbnails_path, method: :post, class: "flex items-center gap-2" do %>
      <%= select_tag :size, options_for_select(ThumbnailGenerator::SIZES.map { |s| [ "#{s}px", s ] }, ThumbnailGenerator::MEDIUM), class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
      <%= submit_tag "Regenerate", data: { turbo_confirm: "Regenerate every thumbnail?" }, class: "rounded border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50 cursor-pointer" %>
    <% end %>
  </div>

  <p class="text-sm text-slate-600">
    Watch progress in the <%= link_to "jobs dashboard", mission_control_jobs_path, class: "underline" %>.
  </p>
</div>
