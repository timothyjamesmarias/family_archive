<% content_for :title, "GEDCOM Import" %>
<h1 class="text-2xl font-semibold text-slate-900 mb-6">GEDCOM Import</h1>

<div class="max-w-xl space-y-6">
  <div class="rounded border border-slate-200 bg-white p-5">
    <p class="text-sm text-slate-600 mb-3">
      Upload a <code>.ged</code> export. Individuals and families are matched by
      their GEDCOM id, so re-importing the same file updates them in place —
      people, relationships, and events added by hand are preserved.
    </p>
    <%= form_with url: admin_gedcom_import_path, method: :post, multipart: true, class: "flex items-center gap-2" do %>
      <%= file_field_tag :file, accept: ".ged", required: true, class: "text-sm" %>
      <%= submit_tag "Import", class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 cursor-pointer" %>
    <% end %>
  </div>

  <% if @last_result %>
    <div class="rounded border <%= @last_result[:success] ? "border-slate-200" : "border-red-200" %> bg-white p-5">
      <h2 class="font-semibold text-slate-900 mb-2">
        Last import — <%= @last_result[:success] ? "succeeded" : "failed" %>
        <span class="font-normal text-slate-500">
          (<%= @last_result[:finished_at].strftime("%Y-%m-%d %H:%M") %>)
        </span>
      </h2>
      <% if @last_result[:success] %>
        <dl class="text-sm text-slate-700 space-y-1">
          <div>Individuals: <%= @last_result[:individuals_imported] %></div>
          <div>Families: <%= @last_result[:families_imported] %></div>
          <div>Events: <%= @last_result[:events_imported] %></div>
          <div>New places: <%= @last_result[:places_imported] %></div>
        </dl>
      <% else %>
        <ul class="text-sm text-red-700 list-disc pl-4">
          <% Array(@last_result[:errors]).each do |error| %>
            <li><%= error %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
  <% end %>

  <p class="text-sm text-slate-600">
    Imports run in the background — watch progress in the
    <%= link_to "jobs dashboard", mission_control_jobs_path, class: "underline" %>.
  </p>
</div>
