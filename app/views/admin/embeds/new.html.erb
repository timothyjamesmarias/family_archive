<%= turbo_frame_tag "embed_picker" do %>
  <%= form_with url: new_admin_embed_path, method: :get, class: "space-y-3", data: { controller: "autosubmit" } do |form| %>
    <div class="flex gap-2">
      <%= form.select :kind, Embed::KINDS.map { |key, kind| [ kind[:label], key ] }, { selected: @kind },
            data: { action: "autosubmit#submit" },
            class: "rounded border border-slate-300 dark:border-slate-600 px-2 py-2 text-sm" %>
      <%= form.search_field :q, value: params[:q], placeholder: "Search", autofocus: true,
            class: "flex-1 rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
      <%= form.submit "Search", name: nil, class: "rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm cursor-pointer" %>
    </div>

    <% if @results.any? %>
      <%= hidden_field_tag "embed[kind]", @kind %>
      <fieldset class="space-y-1 text-sm">
        <% @results.each do |name, id| %>
          <label class="flex items-center gap-2">
            <%= radio_button_tag "embed[embeddable_id]", id, false, required: true %>
            <%= name %>
          </label>
        <% end %>
      </fieldset>
      <fieldset class="space-y-1 text-sm">
        <% Embed::KINDS[@kind][:options].each do |option| %>
          <label class="flex items-center gap-2">
            <%= hidden_field_tag "embed[options][#{option}]", "0", id: nil %>
            <%= check_box_tag "embed[options][#{option}]", "1" %>
            <%= option.humanize %>
          </label>
        <% end %>
      </fieldset>
      <%= form.submit "Insert", name: nil, formaction: admin_embeds_path, formmethod: :post,
            class: "rounded bg-slate-900 dark:bg-slate-700 px-4 py-2 text-sm font-medium text-white cursor-pointer" %>
    <% elsif params[:q].present? %>
      <p class="text-sm text-slate-500">No matches.</p>
    <% end %>
  <% end %>
<% end %>
