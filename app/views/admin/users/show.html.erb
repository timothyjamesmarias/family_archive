<% content_for :title, "User" %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900">User</h1>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_user_path(@user), class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
    <%= button_to "Delete", admin_user_path(@user), method: :delete,
          data: { turbo_confirm: "Delete this user?" },
          class: "rounded border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50 cursor-pointer" %>
  </div>
</div>

<dl class="rounded border border-slate-200 bg-white divide-y divide-slate-100 text-sm">
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500">Name</dt>
    <dd class="text-slate-900"><%= @user.name %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500">Email</dt>
    <dd class="text-slate-900"><%= @user.email %></dd>
  </div>
</dl>

<div class="mt-6">
  <%= link_to "← Back to users", admin_users_path, class: "text-slate-600 underline" %>
</div>
