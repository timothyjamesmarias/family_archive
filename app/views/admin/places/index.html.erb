<% content_for :title, "Places" %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900">Places</h1>
  <%= link_to "New place", new_admin_place_path, class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
</div>

<%= form_with url: admin_places_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search…", class: "w-64 rounded border border-slate-300 px-3 py-2 text-sm" %>
  <%= submit_tag "Search", class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100 cursor-pointer" %>
<% end %>

<div class="overflow-x-auto rounded border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Name</th>
        <th class="px-4 py-3">City</th>
        <th class="px-4 py-3">State province</th>
        <th class="px-4 py-3">Country</th>
        <th class="px-4 py-3">Latitude</th>
        <th class="px-4 py-3">Longitude</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @places.records.each do |place| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3"><%= place.name %></td>
          <td class="px-4 py-3"><%= place.city %></td>
          <td class="px-4 py-3"><%= place.state_province %></td>
          <td class="px-4 py-3"><%= place.country %></td>
          <td class="px-4 py-3"><%= place.latitude %></td>
          <td class="px-4 py-3"><%= place.longitude %></td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <%= link_to "View", admin_place_path(place), class: "text-slate-600 underline" %>
            <%= link_to "Edit", edit_admin_place_path(place), class: "ml-2 text-slate-600 underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "admin/shared/pagination", page: @places, base_url: admin_places_path %>
