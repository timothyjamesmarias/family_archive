<%= form_with model: [ :admin, individual ], class: "max-w-xl space-y-4" do |form| %>
  <%= render "admin/shared/form_errors", record: individual %>

  <div>
    <%= form.label :gedcom_id, "GEDCOM id", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <span class="text-xs text-slate-500 dark:text-slate-400">Leave blank to keep unset</span>
    <%= form.text_field :gedcom_id, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :given_name, class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <%= form.text_field :given_name, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :surname, class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <%= form.text_field :surname, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :sex, class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <%= form.select :sex, [ [ "—", "" ], [ "Male", "M" ], [ "Female", "F" ] ],
          {}, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div class="flex items-center gap-2">
    <%= form.check_box :is_tree_root %>
    <%= form.label :is_tree_root, "Tree root", class: "text-sm font-medium text-slate-700 dark:text-slate-300" %>
  </div>

  <div class="flex gap-2 pt-2">
    <%= form.submit class: "rounded bg-slate-900 dark:bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:hover:bg-slate-600 cursor-pointer" %>
    <%= link_to "Cancel", admin_individuals_path, class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
  </div>
<% end %>
