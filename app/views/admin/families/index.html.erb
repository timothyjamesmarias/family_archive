<% content_for :title, "Families" %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900">Families</h1>
  <%= link_to "New family", new_admin_family_path, class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700" %>
</div>

<%= form_with url: admin_families_path, method: :get, class: "mb-4 flex gap-2" do %>
  <%= text_field_tag :q, params[:q], placeholder: "Search…", class: "w-64 rounded border border-slate-300 px-3 py-2 text-sm" %>
  <%= submit_tag "Search", class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100 cursor-pointer" %>
<% end %>

<div class="overflow-x-auto rounded border border-slate-200 bg-white">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Family</th>
        <th class="px-4 py-3">Gedcom</th>
        <th class="px-4 py-3">Marriage date string</th>
        <th class="px-4 py-3">Divorce date string</th>
        <th class="px-4 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @families.records.each do |family| %>
        <tr class="hover:bg-slate-50">
          <td class="px-4 py-3"><%= family.display_name %></td>
          <td class="px-4 py-3"><%= family.gedcom_id %></td>
          <td class="px-4 py-3"><%= family.marriage_date_string %></td>
          <td class="px-4 py-3"><%= family.divorce_date_string %></td>
          <td class="px-4 py-3 text-right whitespace-nowrap">
            <%= link_to "View", admin_family_path(family), class: "text-slate-600 underline" %>
            <%= link_to "Edit", edit_admin_family_path(family), class: "ml-2 text-slate-600 underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= render "admin/shared/pagination", page: @families, base_url: admin_families_path %>
