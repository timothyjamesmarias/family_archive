<% content_for :title, "Family" %>
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Family</h1>
  <div class="flex gap-2">
    <%= link_to "Edit", edit_admin_family_path(@family), class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
    <%= button_to "Delete", admin_family_path(@family), method: :delete,
          data: { turbo_confirm: "Delete this family?" },
          class: "rounded border border-red-300 dark:border-red-800 px-4 py-2 text-sm text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950 cursor-pointer" %>
  </div>
</div>

<dl class="rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-100 dark:divide-slate-800 text-sm">
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Family</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @family.display_name %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Marriage place</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @family.marriage_place&.name %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Gedcom</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @family.gedcom_id %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Marriage date string</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @family.marriage_date_string %></dd>
  </div>
  <div class="flex px-4 py-3">
    <dt class="w-48 font-medium text-slate-500 dark:text-slate-400">Divorce date string</dt>
    <dd class="text-slate-900 dark:text-slate-100"><%= @family.divorce_date_string %></dd>
  </div>
</dl>

<h2 class="mt-8 mb-3 text-lg font-semibold text-slate-900 dark:text-slate-100">Members</h2>
<div class="rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-100 dark:divide-slate-800 text-sm">
  <% @family.members.sort_by { |m| [ m.parent_role? ? 0 : 1, m.child_order || 0 ] }.each do |member| %>
    <div class="flex px-4 py-3">
      <span class="w-48 font-medium text-slate-500 dark:text-slate-400"><%= member.role.capitalize %></span>
      <%= link_to member.individual&.display_name, admin_individual_path(member.individual_id), class: "text-slate-900 dark:text-slate-100 underline" %>
    </div>
  <% end %>
</div>

<div class="mt-6">
  <%= link_to "← Back to families", admin_families_path, class: "text-slate-600 dark:text-slate-400 underline" %>
</div>
