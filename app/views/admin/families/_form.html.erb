<%= form_with model: [ :admin, family ], class: "max-w-xl space-y-4" do |form| %>
  <%= render "admin/shared/form_errors", record: family %>

  <div>
    <%= form.label :gedcom_id, "GEDCOM id", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <%= form.text_field :gedcom_id, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :marriage_date_string, "Marriage date", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <span class="text-xs text-slate-500 dark:text-slate-400">ISO format (1912-06-30) enables date sorting</span>
    <%= form.text_field :marriage_date_string, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :marriage_place_id, "Marriage place", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <%= form.collection_select :marriage_place_id, Place.order(:name), :id, :name,
          { include_blank: "—" }, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>
  <div>
    <%= form.label :divorce_date_string, "Divorce date", class: "block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1" %>
    <%= form.text_field :divorce_date_string, class: "w-full rounded border border-slate-300 dark:border-slate-600 px-3 py-2 text-sm" %>
  </div>

  <div class="flex gap-2 pt-2">
    <%= form.submit class: "rounded bg-slate-900 dark:bg-slate-700 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 dark:hover:bg-slate-600 cursor-pointer" %>
    <%= link_to "Cancel", admin_families_path, class: "rounded border border-slate-300 dark:border-slate-600 px-4 py-2 text-sm hover:bg-slate-100 dark:hover:bg-slate-800" %>
  </div>
<% end %>
