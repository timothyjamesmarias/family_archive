<% content_for :title, "Not found – Marias Family Archive" %>
<% content_for :minimal_chrome, true %>

<div class="max-w-[52ch] pt-8 pb-14">
  <div class="font-mono text-xs tracking-[0.14em] uppercase text-taupe-600 mb-[18px] dark:text-ink-200">404 &mdash; not found</div>
  <h1 class="font-serif text-[34px] font-medium leading-[1.2] mb-3.5">Nothing is catalogued at this address</h1>
  <p class="text-[17px] leading-[1.7] text-taupe-700 mb-[26px] dark:text-ink-100">
    The item may have been renamed, merged with another record, or never existed.
    Nothing has been deleted &mdash; the archive keeps everything.
  </p>
  <%= form_with url: search_path, method: :get, class: "flex max-w-[420px] mb-[18px]" do %>
    <input type="text" name="q" placeholder="Search the archive instead"
           class="font-sans text-[15px] text-taupe-900 bg-paper-sheet border border-taupe-500 border-r-0 h-[46px] px-3.5 flex-1 min-w-0 dark:text-ink-50 dark:bg-ink-900 dark:border-ink-400">
    <button type="submit" class="btn-primary h-[46px] px-[18px] flex-shrink-0">Search</button>
  <% end %>
  <div class="flex flex-wrap gap-x-5 gap-y-2">
    <a href="<%= artifacts_hub_path %>" class="text-[15px] text-verdigris-700 underline dark:text-verdigris-300">All artifacts</a>
    <a href="<%= family_tree_path %>" class="text-[15px] text-verdigris-700 underline dark:text-verdigris-300">Family tree</a>
    <a href="<%= root_path %>" class="text-[15px] text-verdigris-700 underline dark:text-verdigris-300">Home</a>
  </div>
</div>
