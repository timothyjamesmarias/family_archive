<% content_for :title, "Not found – Marias Family Archive" %>
<% content_for :minimal_chrome, true %>

<div class="max-w-[52ch] pt-8 pb-14">
  <div class="font-mono text-xs tracking-14 uppercase text-taupe-600 mb-4.5 dark:text-ink-200">404 &mdash; not found</div>
  <h1 class="font-serif text-34 font-medium leading-120 mb-3.5">Nothing is catalogued at this address</h1>
  <p class="text-17 leading-170 text-taupe-700 mb-6.5 dark:text-ink-100">
    The item may have been renamed, merged with another record, or never existed.
    Nothing has been deleted &mdash; the archive keeps everything.
  </p>
  <%= form_with url: search_path, method: :get, class: "flex max-w-105 mb-4.5" do %>
    <input type="text" name="q" placeholder="Search the archive instead"
           class="font-sans text-15 text-taupe-900 bg-paper-sheet border border-taupe-500 border-r-0 h-11.5 px-3.5 flex-1 min-w-0 dark:text-ink-50 dark:bg-ink-900 dark:border-ink-400">
    <button type="submit" class="btn-primary h-11.5 px-4.5 flex-shrink-0">Search</button>
  <% end %>
  <div class="flex flex-wrap gap-x-5 gap-y-2">
    <a href="<%= artifacts_hub_path %>" class="text-15 text-verdigris-700 underline dark:text-verdigris-300">All artifacts</a>
    <a href="<%= family_tree_path %>" class="text-15 text-verdigris-700 underline dark:text-verdigris-300">Family tree</a>
    <a href="<%= root_path %>" class="text-15 text-verdigris-700 underline dark:text-verdigris-300">Home</a>
  </div>
</div>
