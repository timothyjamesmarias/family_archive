<% content_for :title, "Family Tree - Marias Family Archive" %>
<%# Tracked so Turbo Drive does a full load into and out of this page: the
    island mounts once on DOMContentLoaded and never tears down. %>
<% content_for :head do %>
  <%= vite_javascript_tag "family_tree.ts", data: { turbo_track: "reload" } %>
  <%= vite_stylesheet_tag "family_tree", data: { turbo_track: "reload" } %>
<% end %>
<div id="family-tree-root" data-auth="<%= user_signed_in? %>"></div>
