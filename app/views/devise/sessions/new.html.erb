<% content_for :title, "Sign in – Marias Family Archive" %>
<% content_for :minimal_chrome, true %>

<%# The failed-attempt alert renders inside the card (screen 13), so pull it
    out of the flash before the layout's global flash renders it too. %>
<% alert_message = flash.delete(:alert) %>

<div class="flex justify-center pt-8 pb-16">
  <div class="w-100 max-w-full">
    <div class="bg-paper-sheet border border-taupe-200 px-8 pt-8 pb-8.5 dark:bg-ink-700 dark:border-ink-500">
      <h1 class="font-serif text-27 font-medium mb-2">Sign in</h1>
      <p class="text-sm leading-160 text-taupe-700 mb-6 dark:text-ink-100">For contributors and admins. Browsing the archive needs no account.</p>

      <% if alert_message %>
        <div class="message message-error px-4 py-3 mb-5">
          <span class="message-label">Error</span>
          <p class="text-sm leading-155 m-0"><%= alert_message %></p>
        </div>
      <% end %>

      <%# Plain full-page post: Turbo intermittently re-renders the form after
          autofill/system tests fill it, submitting empty fields. %>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name),
            html: { data: { turbo: false } }) do |f| %>
        <label class="field mb-4.5">
          <span class="field-label">Email</span>
          <%# No autofocus: Chrome applies it after load, and in system tests it
              steals focus mid-fill so the password keystrokes are lost. %>
          <%= f.email_field :email, autocomplete: "email", required: true, class: "field-input" %>
        </label>

        <label class="field mb-6">
          <span class="field-label">Password</span>
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "field-input" %>
        </label>

        <% if devise_mapping.rememberable? %>
          <label class="flex items-center gap-2.5 text-sm text-taupe-700 mb-6 cursor-pointer dark:text-ink-100">
            <%= f.check_box :remember_me %>
            Remember me
          </label>
        <% end %>

        <%= f.submit "Sign in", class: "btn-primary w-full h-12 cursor-pointer" %>
      <% end %>
    </div>

    <p class="text-sm leading-160 text-taupe-700 text-center mt-4 px-1 dark:text-ink-100">
      Accounts are created by the archive admins.
      <%= link_to "Forgot password", new_password_path(resource_name),
            class: "text-verdigris-700 dark:text-verdigris-300" %>
    </p>
  </div>
</div>
