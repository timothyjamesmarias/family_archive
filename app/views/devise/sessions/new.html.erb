<% content_for :title, "Login - Family Archive" %>
<div class="max-w-md mx-auto">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-6 text-center">
      Admin Login
    </h1>

    <%# Plain full-page post: Turbo intermittently re-renders the form after
        autofill/system tests fill it, submitting empty fields. %>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name),
          html: { data: { turbo: false } }) do |f| %>
      <div class="mb-4">
        <%= f.label :email, "Email", class: "block text-gray-700 dark:text-gray-300 font-medium mb-2" %>
        <%# No autofocus: Chrome applies it after load, and in system tests it
            steals focus mid-fill so the password keystrokes are lost. %>
        <%= f.email_field :email, autocomplete: "email", required: true,
              placeholder: "admin@example.com",
              class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400" %>
      </div>

      <div class="mb-6">
        <%= f.label :password, "Password", class: "block text-gray-700 dark:text-gray-300 font-medium mb-2" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true,
              placeholder: "••••••••",
              class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="mb-6 flex items-center gap-2 text-gray-700 dark:text-gray-300">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, "Remember me" %>
        </div>
      <% end %>

      <%= f.submit "Sign In", class: "w-full btn-primary cursor-pointer" %>
    <% end %>

    <div class="mt-6 text-center space-y-2">
      <p>
        <%= link_to "Forgot your password?", new_password_path(resource_name),
              class: "text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300" %>
      </p>
      <p>
        <%= link_to "← Back to Home", root_path,
              class: "text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 dark:hover:text-blue-300" %>
      </p>
    </div>
  </div>
</div>
