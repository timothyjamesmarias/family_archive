<%# Runs synchronously before first paint — the bundles are deferred module
    scripts, so leaving this to them flashes the light theme on reload.
    Must mirror prefersDark in controllers/dark_mode_controller.ts. %>
<script>
  (function () {
    var stored = localStorage.getItem("theme");
    var dark = stored ? stored === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
    document.documentElement.classList.toggle("dark", dark);
  })();
</script>
