<button
  class="font-mono text-xs text-taupe-600 border border-taupe-200 px-3 py-2.5 cursor-pointer hover:border-taupe-500 hover:text-taupe-900 dark:text-ink-200 dark:border-ink-500 dark:hover:border-ink-200 dark:hover:text-ink-50"
  data-controller="dark-mode"
  data-action="dark-mode#toggle"
  aria-label="Toggle dark mode"
>
  <span class="block dark:hidden">Dark</span>
  <span class="hidden dark:block">Light</span>
</button>
