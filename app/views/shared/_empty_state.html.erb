<%# Empty collection state. Locals: title, description, icon_name. %>
<div class="text-center py-12">
  <%= icon_tag icon_name, css: "w-16 h-16 mx-auto text-gray-400 dark:text-gray-500 mb-4" %>
  <h2 class="text-xl font-semibold text-gray-700 dark:text-gray-300 mb-2"><%= title %></h2>
  <p class="text-gray-500 dark:text-gray-400"><%= description %></p>
</div>
