<% flash.each do |type, message| %>
  <div data-testid="flash-<%= type %>"
       class="mb-4 rounded px-4 py-3 text-sm <%= type.to_sym == :alert ? "bg-red-50 dark:bg-red-950 text-red-800 dark:text-red-300" : "bg-emerald-50 dark:bg-emerald-950 text-emerald-800 dark:text-emerald-300" %>">
    <%= message %>
  </div>
<% end %>