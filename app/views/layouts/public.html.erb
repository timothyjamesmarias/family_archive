<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= content_for(:title) || "Marias Family Archive" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/theme_boot" %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "public" %>
    <%= vite_javascript_tag "public.ts" %>
    <%= yield :head %>
  </head>
  <body class="bg-paper-base text-taupe-900 dark:bg-ink-800 dark:text-ink-50 min-h-screen flex flex-col font-sans">
    <header class="bg-paper-sheet border-b border-taupe-200 dark:bg-ink-700 dark:border-ink-500">
      <div class="max-w-[1360px] mx-auto px-5 sm:px-8 py-[18px]">
        <div class="flex justify-between items-center gap-8">
          <%= link_to "Marias Family Archive", root_path,
                class: "font-serif text-xl font-medium text-taupe-900 no-underline hover:text-verdigris-700 dark:text-ink-50 dark:hover:text-verdigris-300" %>

          <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
            <% artifacts_active = request.path.start_with?("/artifacts") ||
                 ArtifactType.browsable.any? { |type| request.path.start_with?("/#{type.route_segment}") } %>
            <%= link_to "Family Tree", family_tree_path,
                  class: class_names("masthead-link", "masthead-link-active": request.path.start_with?("/family-tree")) %>
            <%= link_to "Artifacts", artifacts_hub_path,
                  class: class_names("masthead-link", "masthead-link-active": artifacts_active) %>
            <%= link_to "Articles", articles_path,
                  class: class_names("masthead-link", "masthead-link-active": request.path.start_with?("/articles")) %>
            <%= link_to "Search", search_path,
                  class: "font-mono text-xs tracking-[0.06em] text-taupe-700 no-underline px-3 py-2.5 border border-taupe-200 ml-2 hover:border-taupe-500 hover:text-verdigris-700 dark:text-ink-100 dark:border-ink-500 dark:hover:border-ink-200 dark:hover:text-verdigris-300" %>
            <span class="w-px h-[22px] bg-taupe-200 mx-2 dark:bg-ink-500" aria-hidden="true"></span>
            <%= render "shared/dark_mode_toggle" %>
            <% if user_signed_in? %>
              <%= link_to "Dashboard", admin_root_path, class: "masthead-link" %>
            <% else %>
              <%= link_to "Sign in", new_user_session_path, class: "masthead-link" %>
            <% end %>
          </nav>

          <div class="md:hidden flex items-center gap-2">
            <%= render "shared/dark_mode_toggle" %>
            <button
              class="p-2 text-taupe-700 hover:bg-taupe-100 dark:text-ink-100 dark:hover:bg-ink-600"
              onclick="window.mobileMenu.toggle()"
              aria-label="Toggle menu"
              id="mobile-menu-button"
            >
              <span class="block" id="hamburger-icon"><%= icon_tag "hamburger" %></span>
              <span class="hidden" id="close-icon"><%= icon_tag "close" %></span>
            </button>
          </div>
        </div>

        <div class="hidden md:hidden" id="mobile-menu">
          <nav class="pt-3 pb-1 flex flex-col" aria-label="Primary">
            <% mobile_link = "block px-3 py-2.5 text-base text-taupe-700 no-underline hover:bg-taupe-100 hover:text-taupe-900 dark:text-ink-100 dark:hover:bg-ink-600 dark:hover:text-ink-50" %>
            <%= link_to "Family Tree", family_tree_path, class: mobile_link %>
            <%= link_to "Artifacts", artifacts_hub_path, class: mobile_link %>
            <%= link_to "Articles", articles_path, class: mobile_link %>
            <%= link_to "Search", search_path, class: mobile_link %>
            <% if user_signed_in? %>
              <%= link_to "Dashboard", admin_root_path, class: mobile_link %>
            <% else %>
              <%= link_to "Sign in", new_user_session_path, class: mobile_link %>
            <% end %>
          </nav>
        </div>
      </div>
    </header>

    <%= yield :breadcrumbs %>

    <%# Banded pages (home) manage their own full-width sections; everything
        else renders inside the shared content container. %>
    <main class="flex-grow <%= "w-full max-w-[1360px] mx-auto px-5 sm:px-8 py-10" unless content_for?(:full_bleed) %>">
      <% if content_for?(:full_bleed) %>
        <div class="w-full max-w-[1360px] mx-auto px-5 sm:px-8"><%= render "layouts/flash" %></div>
      <% else %>
        <%= render "layouts/flash" %>
      <% end %>
      <%= yield %>
    </main>

    <footer class="bg-paper-sheet border-t border-taupe-200 dark:bg-ink-700 dark:border-ink-500">
      <div class="max-w-[1360px] mx-auto px-5 sm:px-8 py-6 flex flex-wrap gap-x-6 gap-y-2.5 items-center justify-between">
        <span class="text-sm text-taupe-600 dark:text-ink-200">© Marias Family Archive</span>
        <span class="meta"><%= archive_holdings_summary %></span>
      </div>
    </footer>
    <%= yield :scripts %>
  </body>
</html>
