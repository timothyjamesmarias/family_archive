<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - Family Archive" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "application" %>
    <%= vite_javascript_tag "application" %>
  </head>

  <body class="bg-slate-50">
    <div class="flex min-h-screen">
      <aside class="w-60 shrink-0 border-r border-slate-200 bg-white flex flex-col">
        <div class="px-5 py-4 border-b border-slate-200">
          <%= link_to "Family Archive", admin_root_path, class: "font-semibold text-slate-900" %>
          <p class="text-xs text-slate-500">Admin</p>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1 text-sm">
          <% nav_item = "block rounded px-3 py-2 text-slate-700 hover:bg-slate-100" %>
          <%= link_to "Dashboard", admin_root_path, class: nav_item %>

          <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Genealogy</p>
          <%= link_to "Individuals", admin_individuals_path, class: nav_item %>
          <%= link_to "Families", admin_families_path, class: nav_item %>
          <%= link_to "Places", admin_places_path, class: nav_item %>

          <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Content</p>
          <%= link_to "Artifacts", admin_artifacts_path, class: nav_item %>
          <%= link_to "Articles", admin_articles_path, class: nav_item %>

          <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">System</p>
          <%= link_to "Users", admin_users_path, class: nav_item %>
          <%= link_to "Thumbnails", admin_thumbnails_path, class: nav_item %>
          <%= link_to "Jobs", mission_control_jobs_path, class: nav_item %>
        </nav>

        <div class="border-t border-slate-200 px-5 py-4 text-sm space-y-2">
          <%= link_to "View site", root_path, class: "block text-slate-600 underline" %>
          <span data-testid="current-user" class="block text-slate-500 truncate"><%= current_user.email %></span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                data: { testid: "sign-out" }, class: "text-slate-600 underline cursor-pointer" %>
        </div>
      </aside>

      <main class="flex-1 px-8 py-8">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
