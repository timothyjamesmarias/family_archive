<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Admin - Family Archive" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= vite_client_tag %>
    <%= vite_stylesheet_tag "application" %>
    <%= vite_javascript_tag "application" %>
  </head>

  <body class="bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100">
    <div class="flex min-h-screen">
      <aside class="w-60 shrink-0 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col">
        <div class="px-5 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between gap-2">
          <div>
            <%= link_to "Family Archive", admin_root_path, class: "font-semibold text-slate-900 dark:text-slate-100" %>
            <p class="text-xs text-slate-500 dark:text-slate-400">Admin</p>
          </div>
          <%= render "shared/dark_mode_toggle" %>
        </div>

        <nav class="flex-1 px-3 py-4 space-y-1 text-sm">
          <% nav_item = "block rounded px-3 py-2 text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800" %>
          <%= link_to "Dashboard", admin_root_path, class: nav_item %>

          <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Genealogy</p>
          <%= link_to "Individuals", admin_individuals_path, class: nav_item %>
          <%= link_to "Families", admin_families_path, class: nav_item %>
          <%= link_to "Places", admin_places_path, class: nav_item %>
          <%= link_to "GEDCOM Import", admin_gedcom_import_path, class: nav_item %>

          <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">Content</p>
          <%= link_to "Artifacts", admin_artifacts_path, class: nav_item %>
          <div class="ml-4">
            <% ArtifactType::ALL.each do |type| %>
              <%= link_to type.plural_display_name, admin_typed_artifacts_path(type.route_segment), class: nav_item %>
            <% end %>
          </div>
          <%= link_to "Articles", admin_articles_path, class: nav_item %>

          <p class="px-3 pt-4 pb-1 text-xs font-semibold uppercase tracking-wide text-slate-400 dark:text-slate-500">System</p>
          <%= link_to "Users", admin_users_path, class: nav_item %>
          <%= link_to "Jobs", mission_control_jobs_path, class: nav_item %>
        </nav>

        <div class="border-t border-slate-200 dark:border-slate-800 px-5 py-4 text-sm space-y-2">
          <%= link_to "View site", root_path, class: "block text-slate-600 dark:text-slate-400 underline" %>
          <span data-testid="current-user" class="block text-slate-500 dark:text-slate-400 truncate"><%= current_user.email %></span>
          <%= button_to "Sign out", destroy_user_session_path, method: :delete,
                data: { testid: "sign-out" }, class: "text-slate-600 dark:text-slate-400 underline cursor-pointer" %>
        </div>
      </aside>

      <main class="flex-1 px-8 py-8">
        <%= render "layouts/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
