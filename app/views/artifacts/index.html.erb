<% content_for :title, "#{@type.plural_display_name} – Marias Family Archive" %>
<% content_for :breadcrumbs do %>
  <div class="bg-taupe-100 border-b border-taupe-200 dark:bg-ink-600 dark:border-ink-500">
    <div class="max-w-[1360px] mx-auto">
      <%= render Ui::BreadcrumbsComponent.new do |trail| %>
        <% trail.with_crumb(label: "Archive", href: root_path) %>
        <% trail.with_crumb(label: "Artifacts", href: artifacts_hub_path) %>
        <% trail.with_crumb(label: @type.plural_display_name) %>
      <% end %>
    </div>
  </div>
<% end %>

<%# Every control link carries the rest of the state; pagination gets the
    same set minus page. %>
<% base_url = "/#{@type.route_segment}" %>
<% control_params = { q: @query.presence, sort: @sort, view: @view }.compact
   @filters.each { |filter| control_params[filter] = "1" } %>
<% link_params = ->(overrides) { control_params.merge(overrides).compact.to_query } %>

<header class="mb-6 flex flex-wrap gap-3 gap-x-6 items-baseline justify-between">
  <div>
    <h1 class="font-serif text-4xl font-medium tracking-[-0.015em] mb-2"><%= @type.plural_display_name %></h1>
    <% if @artifacts.total.positive? %>
      <p class="text-taupe-700 dark:text-ink-100">
        <% if @view == "grid" %>
          <% from = (@artifacts.current_page - 1) * @artifacts.per_page + 1 %>
          <%= @artifacts.total %> <%= "item".pluralize(@artifacts.total) %>
          &nbsp;·&nbsp; showing <%= from %>&ndash;<%= from + @artifacts.records.size - 1 %>
        <% else %>
          <%= @artifacts.total %> <%= "item".pluralize(@artifacts.total) %>
          <% if @transcribed_count %>
            &nbsp;·&nbsp; <%= @transcribed_count %> transcribed
          <% end %>
        <% end %>
      </p>
    <% end %>
  </div>
  <div class="flex border border-taupe-300 dark:border-ink-400">
    <a href="<%= base_url %>?<%= link_params.call(view: "grid", page: nil) %>" class="<%= class_names("segment", "segment-active": @view == "grid") %>">Grid</a>
    <a href="<%= base_url %>?<%= link_params.call(view: "list", page: nil) %>" class="<%= class_names("segment", "segment-active": @view == "list") %>">List</a>
  </div>
</header>

<div class="mb-6 flex flex-wrap gap-2.5 items-center">
  <%= form_with url: base_url, method: :get, data: { controller: "autosubmit" }, class: "contents" do %>
    <input type="text" name="q" value="<%= @query %>"
           placeholder="<%= @type.grid? ? "Search #{@type.plural_display_name.downcase}" : "Search #{@type.plural_display_name.downcase} and transcriptions" %>"
           class="font-sans text-[15px] text-taupe-900 bg-paper-sheet border border-taupe-300 h-[42px] px-3 w-60 max-w-full dark:text-ink-50 dark:bg-ink-900 dark:border-ink-400">
    <select name="sort" data-action="autosubmit#submit"
            class="font-sans text-[15px] text-taupe-900 bg-paper-sheet border border-taupe-300 h-[42px] px-3 dark:text-ink-50 dark:bg-ink-900 dark:border-ink-400">
      <% sort_options = @type.grid? ? %w[newest oldest title] : %w[oldest newest] %>
      <% labels = { "newest" => "Newest first", "oldest" => "Oldest first", "title" => "Title A–Z" } %>
      <% sort_options.each do |sort| %>
        <option value="<%= sort %>" <%= "selected" if @sort == sort %>><%= labels.fetch(sort) %></option>
      <% end %>
    </select>
    <input type="hidden" name="view" value="<%= @view %>">
    <% @filters.each do |filter| %>
      <input type="hidden" name="<%= filter %>" value="1">
    <% end %>
  <% end %>
  <% pills = available_filters %>
  <% if pills.any? %>
    <span class="w-px h-[26px] bg-taupe-200 dark:bg-ink-500" aria-hidden="true"></span>
    <% pill_labels = { "annotated" => "Annotated", "transcribed" => "Transcribed", "translated" => "Translated" } %>
    <% pills.each do |pill| %>
      <% active = @filters.include?(pill) %>
      <a href="<%= base_url %>?<%= link_params.call(pill => active ? nil : "1", page: nil) %>"
         class="<%= class_names("pill", "pill-active": active) %>">
        <%= pill_labels.fetch(pill) %><% if active %><span class="text-verdigris-600 dark:text-verdigris-300" aria-hidden="true">&times;</span><% end %>
      </a>
    <% end %>
  <% end %>
</div>

<% if @artifacts.empty? %>
  <%= render Ui::EmptyStateComponent.new(title: "Nothing catalogued here yet") %>
<% elsif @view == "grid" %>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,230px),1fr))] gap-5">
    <% @artifacts.records.each do |artifact| %>
      <%= render ArtifactCardComponent.new(
            artifact: artifact,
            href: "#{base_url}/#{artifact.slug}",
            badge_count: @type.key == "PHOTO" ? artifact.files.sum { |file| file.annotations.size } : nil
          ) %>
    <% end %>
  </div>
<% else %>
  <div class="bg-paper-sheet border border-taupe-200 dark:bg-ink-700 dark:border-ink-500">
    <% @artifacts.records.each do |artifact| %>
      <%= render ArtifactRowComponent.new(
            artifact: artifact,
            href: "#{base_url}/#{artifact.slug}",
            snippet: artifact.transcription&.transcription_text&.squish&.truncate(150, omission: "")
          ) do |row| %>
        <% if artifact.transcription %>
          <% row.with_status { "Transcribed" } %>
          <% artifact.transcription.translations.each do |translation| %>
            <% row.with_status { "Translated #{translation.target_language.upcase}" } %>
          <% end %>
        <% elsif @type.written_record? %>
          <% row.with_status(tone: :attention) { "Needs transcription" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="mt-8">
  <%= render Ui::PaginationComponent.new(page: @artifacts, base_url: base_url, extra_params: control_params) %>
</div>
