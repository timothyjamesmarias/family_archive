<% content_for :title, "#{@type.plural_display_name} – Marias Family Archive" %>
<% content_for :breadcrumbs do %>
  <div class="bg-taupe-100 border-b border-taupe-200 dark:bg-ink-600 dark:border-ink-500">
    <div class="max-w-340 mx-auto">
      <%= render Ui::BreadcrumbsComponent.new do |trail| %>
        <% trail.with_crumb(label: "Archive", href: root_path) %>
        <% trail.with_crumb(label: "Artifacts", href: artifacts_hub_path) %>
        <% trail.with_crumb(label: @type.plural_display_name) %>
      <% end %>
    </div>
  </div>
<% end %>

<%# Every control link carries the rest of the state; pagination gets the
    same set minus page. %>
<% base_url = "/#{@type.route_segment}" %>
<% control_params = @browse.control_params %>
<% link_params = ->(overrides) { control_params.merge(overrides).compact.to_query } %>

<header class="mb-6 flex flex-wrap gap-3 gap-x-6 items-baseline justify-between">
  <div>
    <h1 class="font-serif text-4xl font-medium tracking-tight mb-2"><%= @type.plural_display_name %></h1>
    <% if @browse.artifacts.total.positive? %>
      <p class="text-taupe-700 dark:text-ink-100">
        <% if @browse.grid? %>
          <% from = (@browse.artifacts.current_page - 1) * @browse.artifacts.per_page + 1 %>
          <%= @browse.artifacts.total %> <%= "item".pluralize(@browse.artifacts.total) %>
          &nbsp;·&nbsp; showing <%= from %>&ndash;<%= from + @browse.artifacts.records.size - 1 %>
        <% else %>
          <%= @browse.artifacts.total %> <%= "item".pluralize(@browse.artifacts.total) %>
          &nbsp;·&nbsp; <%= @browse.transcribed_count %> transcribed
        <% end %>
      </p>
    <% end %>
  </div>
  <div class="flex border border-taupe-300 dark:border-ink-400">
    <a href="<%= base_url %>?<%= link_params.call(view: "grid", page: nil) %>" class="<%= class_names("segment", "segment-active": @browse.view == "grid") %>">Grid</a>
    <a href="<%= base_url %>?<%= link_params.call(view: "list", page: nil) %>" class="<%= class_names("segment", "segment-active": @browse.view == "list") %>">List</a>
  </div>
</header>

<div class="mb-6 flex flex-wrap gap-2.5 items-center">
  <%= form_with url: base_url, method: :get, data: { controller: "autosubmit" }, class: "contents" do %>
    <input type="text" name="q" value="<%= @browse.query %>"
           placeholder="<%= @type.grid? ? "Search #{@type.plural_display_name.downcase}" : "Search #{@type.plural_display_name.downcase} and transcriptions" %>"
           class="font-sans text-15 text-taupe-900 bg-paper-sheet border border-taupe-300 h-10.5 px-3 w-60 max-w-full dark:text-ink-50 dark:bg-ink-900 dark:border-ink-400">
    <select name="sort" data-action="autosubmit#submit"
            class="font-sans text-15 text-taupe-900 bg-paper-sheet border border-taupe-300 h-10.5 px-3 dark:text-ink-50 dark:bg-ink-900 dark:border-ink-400">
      <% labels = { "newest" => "Newest first", "oldest" => "Oldest first", "title" => "Title A–Z" } %>
      <% @browse.sort_options.each do |sort| %>
        <option value="<%= sort %>" <%= "selected" if @browse.sort == sort %>><%= labels.fetch(sort) %></option>
      <% end %>
    </select>
    <input type="hidden" name="view" value="<%= @browse.view %>">
    <% @browse.filters.each do |filter| %>
      <input type="hidden" name="<%= filter %>" value="1">
    <% end %>
  <% end %>
  <% pills = @browse.available_filters %>
  <% if pills.any? %>
    <span class="w-px h-6.5 bg-taupe-200 dark:bg-ink-500" aria-hidden="true"></span>
    <% pill_labels = { "annotated" => "Annotated", "transcribed" => "Transcribed", "translated" => "Translated" } %>
    <% pills.each do |pill| %>
      <% active = @browse.filters.include?(pill) %>
      <a href="<%= base_url %>?<%= link_params.call(pill => active ? nil : "1", page: nil) %>"
         class="<%= class_names("pill", "pill-active": active) %>">
        <%= pill_labels.fetch(pill) %><% if active %><span class="text-verdigris-600 dark:text-verdigris-300" aria-hidden="true">&times;</span><% end %>
      </a>
    <% end %>
  <% end %>
</div>

<% if @browse.artifacts.empty? %>
  <% if @browse.query.present? || @browse.filters.any? %>
    <%# Filtered-empty: name what excluded everything and offer the exit. %>
    <% constraints = @browse.filters.map { |f| { "annotated" => "Annotated", "transcribed" => "Transcribed", "translated" => "Translated" }.fetch(f) } %>
    <% constraints << "“#{@browse.query}”" if @browse.query.present? %>
    <% total = @browse.total_in_collection %>
    <%= render Ui::EmptyStateComponent.new(title: "No #{@type.plural_display_name.downcase} match these filters") do |empty| %>
      <% empty.with_action do %>
        <p class="text-15 leading-165 text-taupe-700 m-0 mx-auto mb-4.5 max-w-[52ch] dark:text-ink-100">
          <%= total %> <%= @type.plural_display_name.downcase %> exist;
          <% if constraints.size > 1 %>
            the combination of <%= safe_join(constraints.map { |c| tag.strong(c, class: "font-semibold text-taupe-900 dark:text-ink-50") }, " and ") %> excludes all of them.
          <% else %>
            <strong class="font-semibold text-taupe-900 dark:text-ink-50"><%= constraints.first %></strong> excludes all of them.
          <% end %>
        </p>
        <a href="<%= base_url %>?<%= { sort: @browse.sort, view: @browse.view }.to_query %>" class="text-15 text-verdigris-700 underline dark:text-verdigris-300">Clear filters</a>
      <% end %>
    <% end %>
  <% else %>
    <%# True-empty: the collection is real and waiting; admins get the upload. %>
    <%= render Ui::EmptyStateComponent.new(
          title: "No #{@type.plural_display_name.downcase} catalogued yet",
          body: "The collection exists and is waiting for its first scan."
        ) do |empty| %>
      <% if user_signed_in? %>
        <% empty.with_action do %>
          <%= render Ui::ButtonComponent.new(href: new_admin_artifact_path(type: @type.key))
                .with_content("Upload the first #{@type.display_name.downcase}") %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% elsif @browse.grid? %>
  <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,230px),1fr))] gap-5">
    <% @browse.artifacts.records.each do |artifact| %>
      <%= render ArtifactCardComponent.new(
            artifact: artifact,
            href: "#{base_url}/#{artifact.slug}",
            badge_count: @type.key == "PHOTO" ? artifact.files.sum { |file| file.annotations.size } : nil
          ) %>
    <% end %>
  </div>
<% else %>
  <div class="bg-paper-sheet border border-taupe-200 dark:bg-ink-700 dark:border-ink-500">
    <% @browse.artifacts.records.each do |artifact| %>
      <%= render ArtifactRowComponent.new(
            artifact: artifact,
            href: "#{base_url}/#{artifact.slug}",
            snippet: artifact.transcription&.transcription_text&.squish&.truncate(150, omission: "")
          ) do |row| %>
        <% if artifact.transcription %>
          <% row.with_status { "Transcribed" } %>
          <% artifact.transcription.translations.each do |translation| %>
            <% row.with_status { "Translated #{translation.target_language.upcase}" } %>
          <% end %>
        <% elsif @type.written_record? %>
          <% row.with_status(tone: :attention) { "Needs transcription" } %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="mt-8">
  <%= render Ui::PaginationComponent.new(page: @browse.artifacts, base_url: base_url, extra_params: control_params) %>
</div>
