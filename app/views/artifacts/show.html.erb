<% title = @artifact.title || @type.untitled_label %>
<% content_for :title, "#{title} – Marias Family Archive" %>

<%# Each type declares its own reader; extra locals are ignored by the
    readers that take no leaf/tab. %>
<% if @type.reader_partial %>
  <%= render @type.reader_partial, artifact: @artifact, type: @type, title: title, leaf: @leaf, tab: @tab %>
<% end %>
