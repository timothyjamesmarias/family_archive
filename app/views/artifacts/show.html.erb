<% title = @artifact.title || @type.untitled_label %>
<% content_for :title, "#{title} – Marias Family Archive" %>

<%# Each type declares its own reader; leaf and tab exist only for the types
    with reader tabs, and their readers are the only ones that take them. %>
<% if @type.reader_partial %>
  <% reader_locals = { artifact: @artifact, type: @type, title: title } %>
  <% reader_locals.merge!(leaf: @leaf, tab: @tab) if @type.reader_tabs %>
  <%# ArtifactType picks the reader, so Herb cannot resolve the partial here. %>
  <%= render @type.reader_partial, **reader_locals %><%# herb:disable actionview-no-implicit-partial %>
<% end %>
