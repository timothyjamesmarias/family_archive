<%# Annotated photo — JS island hooks: data-annotated-photo, data-file-id,
    data-annotations (JSON). Locals: artifact, file (with loaded annotations). %>
<% if file.file.attached? %>
  <% annotations = file.annotations.map do |annotation|
    {
      id: annotation.id,
      annotationText: annotation.annotation_text,
      xCoord: annotation.x_coord.to_f,
      yCoord: annotation.y_coord.to_f
    }
  end %>
  <div class="w-full">
    <div
      class="relative w-full"
      data-annotated-photo="true"
      data-file-id="<%= file.id %>"
      data-annotations="<%= annotations.to_json %>"
    >
      <img
        src="<%= url_for(file.file) %>"
        alt="<%= artifact.title || "Photo #{file.file_sequence}" %>"
        class="w-full h-auto block rounded-lg shadow-sm"
      >
    </div>
  </div>
<% end %>
