<div class="space-y-8">
  <%= render Ui::BreadcrumbsComponent.new do |trail| %>
    <% trail.with_crumb(label: "Archive", href: "#") %>
    <% trail.with_crumb(label: "Letters", href: "#") %>
    <% trail.with_crumb(label: "Letter from Anna Marias, 1931") %>
  <% end %>

  <%= render Ui::TabsComponent.new do |tabs| %>
    <% tabs.with_tab(label: "Scan", href: "#", active: true) %>
