<div class="bg-paper-sheet border border-taupe-200 p-7 dark:bg-ink-700 dark:border-ink-500">
  <%= render MetadataListComponent.new do |list| %>
    <% list.with_row(term: "Identifier") { %(<span class="font-mono text-sm">letter-anna-1931-04</span>).html_safe } %>
    <% list.with_row(term: "Date as written") { "18 April 1931" } %>
    <% list.with_row(term: "Medium") { "Ink on onionskin, 2 leaves, 210 × 148 mm" } %>
    <% list.with_row(term: "People") do %>
      <%= render Ui::LinkComponent.new(href: "#", role: :person).with_content("Anna Marias") %>
      <%= render Ui::LinkComponent.new(href: "#", role: :person).with_content("Josef Marias") %>
    <% end %>
  <% end %>
</div>
