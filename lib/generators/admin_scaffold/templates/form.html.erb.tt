<%%= form_with model: [ :admin, <%= singular_table_name %> ], class: "max-w-xl space-y-4" do |form| %>
  <%%= render "admin/shared/form_errors", record: <%= singular_table_name %> %>

<% attributes.each do |attribute| -%>
<% if attribute.type == :boolean -%>
  <div class="flex items-center gap-2">
    <%%= form.check_box :<%= attribute.name %> %>
    <%%= form.label :<%= attribute.name %>, class: "text-sm font-medium text-slate-700" %>
  </div>
<% else -%>
  <div>
    <%%= form.label :<%= attribute.name %>, class: "block text-sm font-medium text-slate-700 mb-1" %>
    <%%= form.<%= form_field_for(attribute) %> :<%= attribute.name %>, class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
  </div>
<% end -%>
<% end -%>

  <div class="flex gap-2 pt-2">
    <%%= form.submit class: "rounded bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-700 cursor-pointer" %>
    <%%= link_to "Cancel", admin_<%= plural_table_name %>_path, class: "rounded border border-slate-300 px-4 py-2 text-sm hover:bg-slate-100" %>
  </div>
<%% end %>
