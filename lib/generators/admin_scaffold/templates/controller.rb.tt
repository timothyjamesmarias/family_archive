module Admin
  class <%= controller_class_name %>Controller < BaseController
    PER_PAGE = 20
<% if searchable_columns.any? -%>
    SEARCH_COLUMNS = %w[<%= searchable_columns.join(" ") %>].freeze
<% end -%>

    def index
      scope = <%= class_name %>.order(<%= attributes.first ? ":#{attributes.first.name}" : ":id" %>)
<% if searchable_columns.any? -%>
      scope = search(scope) if params[:q].present?
<% end -%>
      @<%= plural_table_name %> = Pagination.paginate(
        scope, page: params.fetch(:page, 1), per_page: PER_PAGE
      )
    end

    def show
      @<%= singular_table_name %> = <%= class_name %>.find(params[:id])
    end

    def new
      @<%= singular_table_name %> = <%= class_name %>.new
    end

    def create
      @<%= singular_table_name %> = <%= class_name %>.new(<%= singular_table_name %>_params)
      if @<%= singular_table_name %>.save
        redirect_to admin_<%= singular_table_name %>_path(@<%= singular_table_name %>), notice: "<%= human_name %> created."
      else
        render :new, status: :unprocessable_entity
      end
    end

    def edit
      @<%= singular_table_name %> = <%= class_name %>.find(params[:id])
    end

    def update
      @<%= singular_table_name %> = <%= class_name %>.find(params[:id])
      if @<%= singular_table_name %>.update(<%= singular_table_name %>_params)
        redirect_to admin_<%= singular_table_name %>_path(@<%= singular_table_name %>), notice: "<%= human_name %> updated."
      else
        render :edit, status: :unprocessable_entity
      end
    end

    def destroy
      <%= class_name %>.find(params[:id]).destroy
      redirect_to admin_<%= plural_table_name %>_path, notice: "<%= human_name %> deleted."
    end

    private

<% if searchable_columns.any? -%>
    def search(scope)
      pattern = "%#{<%= class_name %>.sanitize_sql_like(params[:q])}%"
      clauses = SEARCH_COLUMNS.map { |column| "#{column} ILIKE :pattern" }.join(" OR ")
      scope.where(clauses, pattern: pattern)
    end

<% end -%>
    def <%= singular_table_name %>_params
      params.expect(<%= singular_table_name %>: [ <%= attributes.map { |a| ":#{a.name}" }.join(", ") %> ])
    end
  end
end
